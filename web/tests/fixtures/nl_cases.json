    { "id": "crowbar-thing", "state": "engine", "say": "pick up the crowbar thing", "expect": [{ "type": "take", "item": "prybar" }] },
    { "id": "fire-reactor", "state": "engine", "say": "fire up the reactor", "expect": [{ "type": "use", "item": "reactor" }] },
    { "id": "whats-wrong-reactor", "state": "engine", "say": "what's wrong with the reactor", "expect": [{ "type": "examine", "target": "reactor" }] },
    { "id": "lift-reactor", "state": "engine", "say": "lift the reactor", "expect": [{ "type": "take", "item": "reactor" }] },
    { "id": "return-corridor", "state": "engine", "say": "return to the corridor", "expect": [{ "type": "go", "direction": "north" }] },
    { "id": "crate-unseen", "state": "engine", "say": "open the crate", "expect": ["clarify"] },
    { "id": "typo-pick-prybar", "state": "engine", "say": "pik up teh prybr", "expect": [{ "type": "take", "item": "prybar" }] },
    { "id": "it-prybar", "state": "engine", "setup": ["x prybar"], "say": "take it", "expect": [{ "type": "take", "item": "prybar" }] },

    { "id": "pry-box", "state": "cargo_with_bar", "say": "pry the box open with the bar", "expect": [{ "type": "use", "item": "prybar", "target": "supply_crate" }] },
    { "id": "jam-crowbar", "state": "cargo_with_bar", "say": "jam the crowbar under the lid", "expect": [{ "type": "use", "item": "prybar", "target": "supply_crate" }] },
    { "id": "smash-crate", "state": "cargo_with_bar", "say": "smash the crate", "expect": [{ "type": "use", "item": "prybar", "target": "supply_crate" }, { "type": "open", "target": "supply_crate" }] },
    { "id": "hi-robot", "state": "cargo_with_bar", "say": "say hi to the robot", "expect": [{ "type": "talk", "npc": "maintenance_droid" }] },
    { "id": "chat-r6", "state": "cargo_with_bar", "say": "chat with r-6", "expect": [{ "type": "talk", "npc": "maintenance_droid" }] },
    { "id": "whats-robot", "state": "cargo_with_bar", "say": "what's that robot", "expect": [{ "type": "examine", "target": "maintenance_droid" }] },
    { "id": "battery-hidden", "state": "cargo_with_bar", "say": "grab the battery", "expect": ["clarify"] },
    { "id": "bar-down", "state": "cargo_with_bar", "say": "put the bar down", "expect": [{ "type": "drop", "item": "prybar" }] },
    { "id": "inside-container", "state": "cargo_with_bar", "say": "what's inside the container", "expect": [{ "type": "examine", "target": "supply_crate" }, { "type": "open", "target": "supply_crate" }] },
    { "id": "take-robot", "state": "cargo_with_bar", "say": "take the robot with me", "expect": [{ "type": "take", "item": "maintenance_droid" }, { "type": "talk", "npc": "maintenance_droid" }] },

    { "id": "scoop-glowing", "state": "cargo_crate_open", "say": "scoop up the glowing thing", "expect": [{ "type": "take", "item": "power_cell" }] },
    { "id": "cell-for", "state": "cargo_crate_open", "say": "what is the cell for", "expect": [{ "type": "examine", "target": "power_cell" }] },

    { "id": "stick-battery", "state": "cargo_with_cell", "say": "stick the battery in the robot", "expect": [{ "type": "use", "item": "power_cell", "target": "maintenance_droid" }] },
    { "id": "power-up-droid", "state": "cargo_with_cell", "say": "power up the droid", "expect": [{ "type": "use", "item": "power_cell", "target": "maintenance_droid" }] },
    { "id": "droid-juice", "state": "cargo_with_cell", "say": "give the droid some juice", "expect": [{ "type": "use", "item": "power_cell", "target": "maintenance_droid" }] },
    { "id": "plug-it-in", "state": "cargo_with_cell", "setup": ["x droid"], "say": "plug the cell into it", "expect": [{ "type": "use", "item": "power_cell", "target": "maintenance_droid" }] },
    { "id": "let-go-cell", "state": "cargo_with_cell", "say": "let go of the cell", "expect": [{ "type": "drop", "item": "power_cell" }] },

    { "id": "way-to-pods", "state": "corridor_powered", "say": "open the way to the pod bay", "expect": [{ "type": "open", "target": "pod_door" }, { "type": "traverse", "target": "pod_door" }, { "type": "go", "direction": "north" }] },
    { "id": "head-lifeboats", "state": "corridor_powered", "say": "head for the lifeboats", "expect": [{ "type": "go", "direction": "north" }, { "type": "traverse", "target": "pod_door" }, { "type": "open", "target": "pod_door" }] },
    { "id": "back-engineering", "state": "corridor_powered", "say": "back down to engineering", "expect": [{ "type": "go", "direction": "south" }] },

    { "id": "yank-handle", "state": "pod_bay", "say": "yank the big handle", "expect": [{ "type": "use", "item": "launch_lever" }] },
    { "id": "launch-pod", "state": "pod_bay", "say": "launch the pod", "expect": [{ "type": "use", "item": "launch_lever" }, { "type": "use", "item": "escape_pod" }] },
    { "id": "get-me-out", "state": "pod_bay", "say": "get me out of here", "expect": [{ "type": "use", "item": "launch_lever" }, { "type": "use", "item": "escape_pod" }, "clarify"] },
    { "id": "pod-closely", "state": "pod_bay", "say": "look at the pod closely", "expect": [{ "type": "examine", "target": "escape_pod" }] }
  ]
}
