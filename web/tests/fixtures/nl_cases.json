{
  "about": "Natural-language cases for the interpreter benchmark. Each `say` must be something the parser cannot use (tests/nl_cases.test.js checks), so it reaches the model. `expect` lists every acceptable answer: an action (fields not listed must be absent) or \"clarify\", meaning the right move is to ask — usually because the thing named is not in view.",
  "states": {
    "start": [],
    "corridor": ["e"],
    "engine": ["e", "s"],
    "cargo_with_bar": ["e", "s", "take prybar", "n", "e"],
    "cargo_crate_open": ["e", "s", "take prybar", "n", "e", "use prybar on crate"],
    "cargo_with_cell": ["e", "s", "take prybar", "n", "e", "use prybar on crate", "take power cell"],
    "corridor_powered": ["e", "s", "take prybar", "n", "e", "use prybar on crate", "take power cell", "use power cell on droid", "talk to droid", "w"],
    "pod_bay": ["e", "s", "take prybar", "n", "e", "use prybar on crate", "take power cell", "use power cell on droid", "talk to droid", "w", "open door", "n"]
  },
  "cases": [
    { "id": "read-book", "state": "start", "say": "what does that book say", "expect": [{ "type": "examine", "target": "emergency_manual" }] },
    { "id": "flip-procedures", "state": "start", "say": "flip through the procedures", "expect": [{ "type": "examine", "target": "emergency_manual" }] },
    { "id": "inv-carrying", "state": "start", "say": "what am i carrying", "expect": [{ "type": "inventory" }] },
    { "id": "inv-pockets", "state": "start", "say": "what's in my pockets", "expect": [{ "type": "inventory" }] },
    { "id": "leave-east", "state": "start", "say": "leave to the east", "expect": [{ "type": "go", "direction": "east" }] },
    { "id": "out-hatch", "state": "start", "say": "head out through the hatch", "expect": [{ "type": "go", "direction": "east" }] },
    { "id": "look-around", "state": "start", "say": "take a look around", "expect": [{ "type": "look" }] },
    { "id": "describe-place", "state": "start", "say": "can you describe this place", "expect": [{ "type": "look" }] },
    { "id": "pocket-manual", "state": "start", "say": "pocket the manual", "expect": [{ "type": "take", "item": "emergency_manual" }] },
    { "id": "dance", "state": "start", "say": "dance wildly", "expect": ["clarify"] },
    { "id": "sing", "state": "start", "say": "sing a sea shanty", "expect": ["clarify"] },
    { "id": "crowbar-unseen", "state": "start", "say": "grab the crowbar", "expect": ["clarify"] },
    { "id": "any-noise", "state": "start", "say": "is anything making noise", "expect": [{ "type": "listen" }] },
    { "id": "typo-check-manual", "state": "start", "say": "chek teh mnual", "expect": [{ "type": "examine", "target": "emergency_manual" }] },

    { "id": "console-thing", "state": "corridor", "say": "I want to check out the console thing", "expect": [{ "type": "examine", "target": "status_console" }] },
    { "id": "screen-showing", "state": "corridor", "say": "what is the screen showing", "expect": [{ "type": "examine", "target": "status_console" }] },
    { "id": "try-pod-door", "state": "corridor", "say": "try the pod bay door", "expect": [{ "type": "open", "target": "pod_door" }, { "type": "traverse", "target": "pod_door" }] },
    { "id": "heavy-door", "state": "corridor", "say": "go through the heavy door", "expect": [{ "type": "traverse", "target": "pod_door" }, { "type": "open", "target": "pod_door" }, { "type": "go", "direction": "north" }] },
    { "id": "back-quarters", "state": "corridor", "say": "back to the crew quarters", "expect": [{ "type": "go", "direction": "west" }] },
    { "id": "over-to-cargo", "state": "corridor", "say": "head over to the cargo bay", "expect": [{ "type": "go", "direction": "east" }] },
    { "id": "make-way-south", "state": "corridor", "say": "make my way south", "expect": [{ "type": "go", "direction": "south" }] },
    { "id": "listen-big-door", "state": "corridor", "say": "listen at the big door", "expect": [{ "type": "listen", "target": "pod_door" }, { "type": "listen" }] },
    { "id": "metal-bar-unseen", "state": "corridor", "say": "snag the metal bar", "expect": ["clarify"] },
    { "id": "battery-unseen", "state": "corridor", "say": "grab the battery", "expect": ["clarify"] },
    { "id": "console-buttons", "state": "corridor", "say": "push the console buttons", "expect": [{ "type": "use", "item": "status_console" }, { "type": "examine", "target": "status_console" }] },
    { "id": "it-console", "state": "corridor", "setup": ["x console"], "say": "what does it say", "expect": [{ "type": "examine", "target": "status_console" }] },

